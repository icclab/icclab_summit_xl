<?xml version="1.0"?>
<robot name="back_box" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="back_box" params="prefix parent *origin">

    <joint name="back_box_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="back_box_link"/>
    </joint>

    <material name="black">
      <color rgba="0 0 0 0"/>
    </material>

    <link name="back_box_link">
      <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>		  
          <box size="0.25 0.4 0.20" />
        </geometry>
        <material name="black"/>
      </visual> -->
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.25 0.4 0.20" />
        </geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0167" ixy="0" ixz="0" iyy="0.0085" iyz="0" izz="0.0185"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
