<robot name="summit_xl">
  <!-- ***************** -->
  <!-- Imported elements -->
  <!-- ***************** -->
  <!-- First we import all posible elements defined in the urdf.xacro files. All these elements are defined as macro:xacros -->
  <gazebo reference="base_footprint">
    <material>Gazebo/Green</material>
  </gazebo>
  <!-- in kg-->
  <!-- Source: https://en.wikipedia.org/wiki/List_of_moments_of_inertia-->
  <!-- source en.wikipedia.org/wiki/List_of_moments_of_inertia-->
  <!-- This file unifies all sensors that can be used on simulation, defined as xacro:macros -->
  <!-- Includes -->
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- <xacro:icclab_summit_arm simulation="true">
			<origin xyz="0.255 0 0.275" rpy="0 0 ${pi}" />
	</xacro:icclab_summit_arm> -->
  <gazebo>
    <!-- <plugin name="omni_steering" filename="libgazebo_ros_planar_move.so">
	      <commandTopic>robotnik_base_control/cmd_vel</commandTopic>
	      <odometryTopic>robotnik_base_control/odom</odometryTopic>
	      <odometryFrame>${prefix}odom</odometryFrame>
	      <odometryRate>50.0</odometryRate>
	      <robotBaseFrame>${prefix}base_footprint</robotBaseFrame>
	      <publishTF>${publish_tf}</publishTF>
		  <enableYAxis>true</enableYAxis>
	    </plugin> -->
    <plugin filename="libgazebo_ros_planar_move.so" name="planar_move">
      <ros>
        <namespace>summit</namespace>
        <remapping>/tf:=tf</remapping>
        <!-- <remapping>cmd_vel:=robotnik_base_control/cmd_vel</remapping>
          <remapping>odom:=robotnik_base_control/odom</remapping> -->
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>100</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>True</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <!-- TOF: was ${namespace}/odom -->
      <robot_base_frame>base_footprint</robot_base_frame>
      <!-- TOF: was ${namespace}/base_footprint-->
    </plugin>
  </gazebo>
