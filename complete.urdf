  <gazebo reference="arm_camera_link">
    <sensor name="arm_camera" type="depth">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1,04719755</horizontal_fov>
        <vertical_fov>0.86393798</vertical_fov>
        <image>
          <format>B8G8R8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <!-- plugin https://docs.ros.org/en/ros2_packages/rolling/api/gazebo_plugins/generated/classgazebo__plugins_1_1GazeboRosCamera.html -->
      <plugin filename="libgazebo_ros_camera.so" name="arm_camera">
        <ros>
          <namespace>summit</namespace>
          <remapping>~/image_raw:=~/color/image_raw</remapping>
          <remapping>~/camera_info:=~/color/camera_info</remapping>
          <remapping>~/image_raw/compressed:=~/color/image_raw/compressed</remapping>
          <remapping>~/image_raw/compressedDepth:=~/color/image_raw/compressedDepth</remapping>
          <remapping>~/image_raw/theora:=~/color/image_raw/theora</remapping>
        </ros>
        <camera_name>arm_camera</camera_name>
        <frame_name>arm_camera_color_optical_frame</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>20.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="ros_control">
      <namespace>summit</namespace>
      <parameters></parameters>
    </plugin>
  </gazebo>
  <ros2_control name="robotnik_base_hw" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>
